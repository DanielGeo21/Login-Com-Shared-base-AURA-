<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MeuApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Suas configurações normais de cor aqui -->
    </style>

    <!-- Tema exclusivo para a Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Cor de fundo igual à sua tela de Login (#0A1128) -->
        <item name="windowSplashScreenBackground">#0A1128</item>

        <!-- Ícone do centro da tela (use seu logotipo ou o ic_launcher) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Tema para qual o app mudará após a splash sumir -->
        <item name="postSplashScreenTheme">@style/Base.Theme.MeuApp</item>
    </style> />
</resources>